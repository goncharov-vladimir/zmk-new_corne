#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
// Include the WS2812 widget behavior
#include <behaviors/ws2812_widget.dtsi>
#include <behaviors/ws2812_layer.dtsi>

#define WS2812_TOGGLE 254
#define DISPLAY_ROTATE 253

#define BASE 0
#define NUM  1
#define SYM  2
#define FN   3

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    /* zmk,ws2812-widget задаётся в overlay каждой половинки (boards/arm/eyelash_corne/).
     * На донгле led_strip нет — ws2812-widget там не нужен (только behavior relay). */

    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Word Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&caps_word>;
        };

        td_lang: td_lang {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Right Alt/Language Tap Dance";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp RALT>, <&kp CAPS>;
        };
    };

    /* ============================================================
     * Подсветка слоёв: автоматическая. Центральный слушатель в
     * widget.c при смене слоя ретранслирует
     * &ws2812_layer <слой> на обе половинки (global behavior).
     * Поэтому в keymap используются обычные &mo / &lt — никаких
     * макросов не нужно. Цвета задаются в widget.c (per-key таблицы).
     *
     * &ws2812_wdg 0xFF — автоопределение слоя (central) или
     *   использование сохранённого слоя (peripheral)
     * &ws2812_layer N — установить цвет слоя N (relay на peripheral)
     * ============================================================ */

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&ws2812_wdg 0xFF>, <&ws2812_wdg 0xFF>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    rpi: require_prior_idle {
                compatible = "zmk,behavior-hold-tap";
                #binding-cells = <2>;
                flavor = "balanced";
                tapping-term-ms = <250>;
                quick-tap-ms = <175>;
                require-prior-idle-ms = <125>;
                bindings = <&kp>, <&kp>;
    };

    combos {
        compatible = "zmk,combos";
        softoff {
            bindings = <&soft_off>;
            key-positions = <42 43 47>;
            timeout-ms = <100>;
            layers = <BASE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        fn_layer {
            if-layers = <NUM SYM>;
            then-layer = <FN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q          &kp W  &kp E     &kp R                &kp T                                                   &kp UP                &kp Y          &kp U               &kp I                  &kp O                &kp P                 &mt LEFT_GUI LEFT_BRACKET
&td0       &rpi LCTRL A   &rpi LEFT_ALT S  &rpi LEFT_GUI D      &rpi LSHFT F   &kp G                          &kp LEFT  &kp ENTER  &kp RIGHT  &kp H          &rpi RSHFT J        &rpi RIGHT_GUI K       &rpi RIGHT_ALT L     &rpi RCTRL SEMI       &kp APOS
&kp LCTRL  &kp Z          &kp X            &kp C                &kp V          &kp B   &kp SPACE                        &kp DOWN              &kp N          &kp M               &kp COMMA              &kp DOT              &kp FSLH              &kp RIGHT_BRACKET
                                                                &kp BSPC       &mo NUM   &kp SPACE            &kp ENTER  &mo SYM    &td_lang
            >;

             sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        lower_layer {
            display-name = "Numbers";
            bindings = <
&kp ESC    &trans           &trans          &trans        &trans          &trans                                         &mmv MOVE_UP                      &kp N7           &kp N8           &kp N9          &kp N0           &kp MINUS &kp BSPC
&trans    &kp LEFT          &kp DOWN        &kp UP        &kp RIGHT       &trans                          &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp N4           &kp N5          &kp N6           &kp RIGHT        &kp HOME  &kp PG_UP
&trans    &trans            &trans          &trans        &trans          &trans  &kp C_MUTE                    &mmv MOVE_DOWN                      &kp N1           &kp N2           &kp N3           &kp DOT          &kp END   &kp PG_DN
                                &trans     &trans     &kp SPACE                                                              &kp RET    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        raise_layer {
            display-name = "Symbols";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                                  &mmv MOVE_UP                        &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &kp GRAVE     &kp BSLH      &kp PIPE   &kp LBKT   &kp RBKT                      &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &kp TILDE     &kp FSLH      &kp UNDER  &kp LBRC   &kp RBRC      &kp PLUS                  &mmv MOVE_DOWN                      &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &trans     &kp SPACE                                                              &kp RET    &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&ws2812_wdg WS2812_TOGGLE  &kp F1           &kp F2          &kp F3        &kp F4        &kp F5                                         &mmv MOVE_UP                             &kp F6                &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&ws2812_wdg 0xFF        &out OUT_TOG     &trans          &ws2812_wdg DISPLAY_ROTATE  &trans        &trans                       &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT            &trans                &trans     &trans       &trans      &kp PRINTSCREEN  &kp F12
&trans     &bt BT_CLR       &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3     &mkp RCLK                      &mmv MOVE_DOWN                          &trans                &trans     &trans       &trans      &kp SCROLLLOCK   &kp PAUSE_BREAK

                                &trans     &trans   &trans                                                               &trans     &trans     &trans
            >;

            sensor-bindings = <&scroll_encoder>;
        };

    };
};
