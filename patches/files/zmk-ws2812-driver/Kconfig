config ZMK_WS2812_LAYER_BEHAVIOR
	bool "Enable WS2812 split behavior relay"
	default y if WS2812_WIDGET
	help
	  Build the WS2812 behavior drivers used to relay layer and test
	  commands from a split central to its peripherals.

config WS2812_WIDGET
	bool "Enable WS2812 LED widget for showing battery and output status"
	depends on LED_STRIP
	select LED_STRIP_WS2812
	help
	  Enable WS2812 RGB LED widget for keyboard status indication.

if WS2812_WIDGET

