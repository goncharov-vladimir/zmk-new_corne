# Layer-specific LED masks (which LEDs to light up per layer)
# Each bit corresponds to an LED in the strip (bit 0 = LED 0, bit 1 = LED 1, etc.)
# Set to 0x1FFFFF (all 21 LEDs) by default. Set to 0x000000 to turn off all LEDs.
config WS2812_WIDGET_LAYER_0_MASK
	hex "Layer 0 LED mask (0=off, all bits set=all LEDs)"
	default 0x000000
	depends on WS2812_WIDGET_SHOW_LAYER_CHANGE

config WS2812_WIDGET_LAYER_1_MASK
	hex "Layer 1 LED mask"
	default 0x1FFFFF
	depends on WS2812_WIDGET_SHOW_LAYER_CHANGE

config WS2812_WIDGET_LAYER_2_MASK
	hex "Layer 2 LED mask"
	default 0x1FFFFF
	depends on WS2812_WIDGET_SHOW_LAYER_CHANGE

config WS2812_WIDGET_LAYER_3_MASK
	hex "Layer 3 LED mask"
	default 0x1FFFFF
	depends on WS2812_WIDGET_SHOW_LAYER_CHANGE

config WS2812_WIDGET_LAYER_4_MASK
	hex "Layer 4 LED mask"
	default 0x1FFFFF
	depends on WS2812_WIDGET_SHOW_LAYER_CHANGE

config WS2812_WIDGET_LAYER_5_MASK
	hex "Layer 5 LED mask"
	default 0x1FFFFF
	depends on WS2812_WIDGET_SHOW_LAYER_CHANGE

config WS2812_WIDGET_LAYER_6_MASK
	hex "Layer 6 LED mask"
	default 0x1FFFFF
	depends on WS2812_WIDGET_SHOW_LAYER_CHANGE

config WS2812_WIDGET_LED_TEST
	bool "LED index test mode: cycle through each LED one at a time"
	default n
	depends on WS2812_WIDGET
	help
	  When enabled, the widget will cycle through each LED one at a time
	  on startup, lighting up LED 0, then LED 1, etc. with a 1.5-second
	  delay. This helps identify which physical key corresponds to
	  which LED index. Check the serial log for "LED TEST: N" messages.

config WS2812_WIDGET_AUTO_SCAN
	bool "Automatically scan raw LED addresses on startup"
	default n
	depends on WS2812_WIDGET_LED_TEST
	help
	  Diagnostic firmware mode. Shows a white start marker, then raw LED
	  addresses 0 through 20 one at a time, followed by a magenta end marker.
	  Addresses 0-6 are red, 7-13 green, and 14-20 blue.

# ── Animation effects (matching rgb_underglow API) ──────────────────────

config WS2812_WIDGET_EFFECT
	int "Default animation effect (0=solid, 1=breathe, 2=spectrum, 3=swirl)"
	default 0
	range 0 3
	depends on WS2812_WIDGET
	help
	  Select the default animation effect for the WS2812 widget.
	  0 = solid (single colour, no animation)
	  1 = breathe (pulsing brightness)
	  2 = spectrum (hue cycling, all LEDs same colour)
	  3 = swirl (rainbow wave across LEDs)
	  The layer mask is always respected — only masked LEDs show the effect.

config WS2812_WIDGET_ANIMATION_SPEED
	int "Default animation speed (1-5)"
	default 3
	range 1 5
	depends on WS2812_WIDGET
	help
	  Animation speed for breathe/spectrum/swirl effects. 1=slow, 5=fast.

config WS2812_WIDGET_BRT_MIN
	int "Minimum brightness percentage for animation effects"
	default 0
	range 0 100
	depends on WS2812_WIDGET
	help
	  Minimum brightness as a percentage (0-100). Used in breathe and
	  solid effects to prevent the LEDs from going completely dark.

config WS2812_WIDGET_BRT_MAX
	int "Maximum brightness percentage for animation effects"
	default 100
	range 0 100
	depends on WS2812_WIDGET
	help
	  Maximum brightness as a percentage (0-100).

